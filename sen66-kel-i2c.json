{
    "name": "Sensirion SEN66 via KEL I2C to UART",
    "send_cmd_period_ms": 10000,
    "port": {
        "baudRate": 9600,
        "dataBits": 8,
        "stopBits": 1,
        "parity": "none",
        "inter_frame_gap_ms": 30
    },
    "commands": [
        {
            "_comment": "Start Continuous Measurement SEN6x 0x0021 (addr 0x6B), 50 ms execution time",
            "command": "1B 41 6B 57 02 77 00 21 52 00 53",
            "postDelay_ms": 1200,
            "repeat": 0
        },
        {
            "_comment": "Get Data Ready SEN6x 0x0202",
            "command": "1B 41 6B 57 02 77 02 02 52 00 53",
            "postDelay_ms": 200,
            "repeat": 0
        },
        {
            "command": "1B 41 6B 57 00 52 03 53",
            "postDelay_ms": 200,
            "repeat": 0
        },
        {
            "_comment": "Passes only if CRC valid AND status word == 0x0001 (data ready)",
            "command": "72",
            "frame": {
                "length": 3,
                "startByte": "none",
                "endByte": "none",
                "stuffing": [
                    ["5C B1", "1B"],
                    ["5C C5", "5C"]
                ]
            },
            "checksum": {
                "eval": "(data.slice(0,2).reduce((c,b)=>(c^=b,Array.from({length:8},()=>c=(c&0x80)?((c<<1)^0x31)&0xFF:(c<<1)&0xFF),c),0xFF)===data[2]&&((data[0]<<8)+data[1])===1)?1:0",
                "compare": "1"
            },
            "postDelay_ms": 30000,
            "repeat": 0
        },
        {
            "_comment": "Read Measured Values SEN66 0x0300 - priming read (CO2 is 0xFFFF for first 5..6 s, NOx for first 10..11 s)",
            "command": "1B 41 6B 57 02 77 03 00 52 00 53",
            "postDelay_ms": 300,
            "repeat": 0
        },
        {
            "_comment": "RLENGTH 27 = 0x1B, must be escaped as 5C B1",
            "command": "1B 41 6B 57 00 52 5C B1 53",
            "postDelay_ms": 300,
            "repeat": 0
        },
        {
            "command": "72",
            "repeat": 0,
            "postDelay_ms": 300
        },

        {
            "_comment": "--- measurement loop ---",
            "command": "1B 41 6B 57 02 77 03 00 52 00 53",
            "postDelay_ms": 5000,
            "repeat": 1
        },
        {
            "command": "1B 41 6B 57 00 52 5C B1 53",
            "postDelay_ms": 300,
            "repeat": 1
        },
        {
            "command": "72",
            "frame": {
                "length": 27,
                "startByte": "none",
                "endByte": "none",
                "stuffing": [
                    ["5C B1", "1B"],
                    ["5C C5", "5C"]
                ]
            },
            "checksum": {
                "eval": "[0,3,6,9,12,15,18,21,24].every(i=>data.slice(i,i+2).reduce((c,b)=>(c^=b,Array.from({length:8},()=>c=(c&0x80)?((c<<1)^0x31)&0xFF:(c<<1)&0xFF),c),0xFF)===data[i+2])?1:0",
                "compare": "1"
            },
            "data": {
                "PM1.0":  { "value": "((data[0] << 8) + data[1]) / 10",                     "unit": "μg/m³" },
                "PM2.5":  { "value": "((data[3] << 8) + data[4]) / 10",                     "unit": "μg/m³" },
                "PM4.0":  { "value": "((data[6] << 8) + data[7]) / 10",                     "unit": "μg/m³" },
                "PM10.0": { "value": "((data[9] << 8) + data[10]) / 10",                    "unit": "μg/m³" },
                "RH":     { "value": "((((data[12] << 8) + data[13]) << 16 >> 16)) / 100",  "unit": "%RH" },
                "Temp":   { "value": "((((data[15] << 8) + data[16]) << 16 >> 16)) / 200",  "unit": "°C" },
                "VOC":    { "value": "((((data[18] << 8) + data[19]) << 16 >> 16)) / 10",   "unit": "index" },
                "NOx":    { "value": "((((data[21] << 8) + data[22]) << 16 >> 16)) / 10",   "unit": "index" },
                "CO2":    { "value": "(data[24] << 8) + data[25]",                          "unit": "ppm" }
            },
            "repeat": 1,
            "postDelay_ms": 300
        }
    ]
}
