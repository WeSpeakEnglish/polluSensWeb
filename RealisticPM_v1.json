{
  "sensors": [
    {
      "name": "Realistic PM v1",
      "command": "none",
      "port": { "baudRate": 9600, "dataBits": 8, "stopBits": 1, "parity": "none" },
      "frame": {
        "length": 20,
        "startByte": "0x52",
        "endByte": "0x0A"
      },
      "checksum": {
        "eval": "data[17] === 77 && data[18] === 13 ? (parseInt(String.fromCharCode(...data.slice(1, 5)), 16) + parseInt(String.fromCharCode(...data.slice(5, 9)), 16) + parseInt(String.fromCharCode(...data.slice(9, 13)), 16)) & 0xFFFF : -1",
        "compare": "parseInt(String.fromCharCode(...data.slice(13, 17)), 16)"
      },
      "data": {
        "PM10":  { "value": "parseInt(String.fromCharCode(...data.slice(1, 5)), 16) / 10",  "unit": "μg/m³" },
        "PM2.5": { "value": "parseInt(String.fromCharCode(...data.slice(5, 9)), 16) / 10",  "unit": "μg/m³" },
        "PM1.0": { "value": "parseInt(String.fromCharCode(...data.slice(9, 13)), 16) / 10", "unit": "μg/m³" }
      }
    }
  ]
}